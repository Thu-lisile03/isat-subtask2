bool isValidBinary(string binary)
{
    if (binary.empty())
        return false;

    for (char digit : binary)
    {
        if (digit != '0' && digit != '1')
            return false;
    }

    return true;
}

// Function to check if hexadecimal number is valid
bool isValidHexadecimal(string hexadecimal)
{
    if (hexadecimal.empty())
        return false;

    for (char digit : hexadecimal)
    {
        if (!((digit >= '0' && digit <= '9') ||
              (digit >= 'A' && digit <= 'F') ||
              (digit >= 'a' && digit <= 'f')))
        {
            return false;
        }
    }

    return true;
}

